extends CharacterBody2D

@onready var anim: AnimatedSprite2D = $AnimatedSprite2D


var vida = 1
var monedas = 0
var velocidad := 300.0
var vel_salto := -400.0


func _physics_process(delta: float) -> void:
	
	if not is_on_floor():
		velocity += get_gravity() * delta
	
	#Si cambiaron las teclas de acción pongan el nombre que le dieron ustedes
	var direccion = Input.get_axis("ui_left", "ui_right")
	velocity.x = direccion * velocidad
	
	if direccion == -1:
		anim.flip_h = true
	else:
		anim.flip_h = false
	
	if velocity.x !=0:
		anim.play("Correr")
	else: anim.play("Idle")
	
	if velocity.y <0:
		anim.play("Saltar")
	elif velocity.y >0:
		anim.play("Caer")
	
	
	if Input.is_action_just_pressed("ui_accept"):
		velocity.y = vel_salto
		
	
	
	
	move_and_slide()


func morir():
	vida -=1
	if vida <= 0:
		global_position = Vector2(40.0, 180.0)

func ganar_monedas():
	monedas+=1
	print("Tienes: " + str(monedas) + "Monedas")
